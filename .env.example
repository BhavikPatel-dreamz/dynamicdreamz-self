# Search indexing is off until launch. Set to true when this property should
# appear in Google Search.
ALLOW_SEARCH_INDEXING=false

# Site URL
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ==============================================================================
# Payload CMS Configuration
# ==============================================================================
# PostgreSQL connection string (Neon DB, Supabase, AWS RDS, or local Postgres)
DATABASE_URI=postgresql://user:password@host/database?sslmode=require

# Secure random secret key for Payload auth and encryption
PAYLOAD_SECRET=your_payload_secret_key_here

# ==============================================================================
# Custom Media Server Storage (https://media.dynamicdreamz.net)
# ==============================================================================
MEDIA_SERVER_URL=https://media.dynamicdreamz.net
MEDIA_SERVER_API_KEY=your_media_server_api_key_here

# Google Workspace SMTP Configuration                                            
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=your-workspace-email@dynamicdreamz.com
SMTP_PASS=abcdefghijklmnop

# Email Delivery Settings                                                                           
EMAIL_FROM="Dynamic Dreamz <your-workspace-email@dynamicdreamz.com>"
EMAIL_FROM_NAME="Dynamic Dreamz"
COMPANY_NOTIFICATION_EMAIL=leads@dynamicdreamz.com