# Search indexing is off until launch. Set to true when this property should
# appear in Google Search.
ALLOW_SEARCH_INDEXING=false

# Site URL
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ==============================================================================
# Payload CMS Configuration
# ==============================================================================
# PostgreSQL connection string (Neon DB, Supabase, AWS RDS, or local Postgres)
DATABASE_URI=postgresql://user:password@host/database?sslmode=require

# Secure random secret key for Payload auth and encryption
PAYLOAD_SECRET=your_payload_secret_key_here