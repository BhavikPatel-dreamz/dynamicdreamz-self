# Search indexing is off until launch. Set to true when this property should
# appear in Google Search.
ALLOW_SEARCH_INDEXING=false

# Site URL
NEXT_PUBLIC_SITE_URL=your domain url

# ==============================================================================
# Strapi Headless CMS Configuration
# ==============================================================================
# The base URL of your Strapi instance.
# Development: http://localhost:1337
# Production: https://cms.dynamicdreamz.com (or your hosted Strapi URL)
STRAPI_API_URL=http://localhost:1337

# API Token generated in Strapi Admin:
# Go to: Strapi Admin -> Settings -> API Tokens -> Create new API Token
# Choose Token type: Read-only (or Custom with read permissions for collection/single types)
STRAPI_API_TOKEN=your_strapi_api_token_here

# Random secure secret string used to authenticate Next.js Draft Mode preview requests
# Must match the preview secret configured in Strapi Preview Link / Button
STRAPI_PREVIEW_SECRET=your_strapi_preview_secret_here

# Random secure secret string used to authenticate Strapi Webhook revalidation requests
# Must match the secret parameter in Strapi Webhook URL (e.g. /api/revalidate?secret=...)
STRAPI_REVALIDATE_SECRET=your_strapi_revalidate_secret_here